# API environment variables (for local development without Docker)
# Copy to .env in apps/api/ directory.

# MongoDB connection
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=thai_food_api

# Imgur image hosting (optional — predictions work without it)
IMGUR_CLIENT_ID=

# Hugging Face model repository (default: PlaiPunlawat/thai-food-classifier)
HF_MODEL_REPO=PlaiPunlawat/thai-food-classifier

# Flask environment (development | production | testing)
FLASK_ENV=development
FLASK_DEBUG=False
